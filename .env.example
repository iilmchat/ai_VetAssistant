# ============================================================================
# VetAssistant — шаблон переменных окружения.
# Скопируйте в `.env` и заполните своими значениями:  cp .env.example .env
# Файл `.env` в git НЕ попадает (см. .gitignore). Секреты — только там.
# ============================================================================

# --- Учитель (генерация синтетики), OpenAI-совместимый endpoint -------------
# Любой провайдер с /v1/chat/completions: агрегатор, OpenAI, self-hosted vLLM.
TEACHER_API_KEY=sk-replace-me
TEACHER_BASE_URL=https://api.openai.com/v1
TEACHER_MODEL=gpt-4.1-mini

# --- Судья (LLM-Judge для eval, задачи T-006/T-007) -------------------------
# Заполняется на этапе eval. Можно указать тот же провайдер, что и для учителя.
# JUDGE_API_KEY=
# JUDGE_BASE_URL=
# JUDGE_MODEL=
