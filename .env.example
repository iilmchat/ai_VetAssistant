# ============================================================================
# VetAssistant — шаблон переменных окружения.
# Скопируйте в `.env` и заполните своими значениями:  cp .env.example .env
# Файл `.env` в git НЕ попадает (см. .gitignore). Секреты — только там.
# ============================================================================

# --- Учитель: primary-провайдер (обязателен) --------------------------------
# Любой провайдер с /v1/chat/completions: DeepSeek, агрегатор, self-hosted vLLM.
TEACHER_PRIMARY_API_KEY=sk-replace-me
TEACHER_PRIMARY_BASE_URL=https://api.deepseek.com/v1
TEACHER_PRIMARY_MODEL=deepseek-flash

# --- Учитель: fallback-провайдер (опционально) ------------------------------
# Нужен только для `--provider fallback` (scripts/run_pilot.py, test_api.py).
# Если переменные не заданы, запрос fallback падает с понятной ошибкой.
# TEACHER_FALLBACK_API_KEY=
# TEACHER_FALLBACK_BASE_URL=
# TEACHER_FALLBACK_MODEL=

# --- Учитель: GigaChat (опционально, OAuth) ---------------------------------
# Нужен только для `--provider gigachat` (T-012). Токен запрашивается
# автоматически и обновляется за минуту до истечения (живёт 30 минут).
# client_id/client_secret — пара из личного кабинета GigaChat.
# GIGACHAT_CLIENT_ID=
# GIGACHAT_CLIENT_SECRET=
# GIGACHAT_BASE_URL=https://api.giga.chat/v1
# GIGACHAT_MODEL=GigaChat-2-Max
# GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
# GIGACHAT_SCOPE=GIGACHAT_API_PERS

# --- FastAPI / GGUF (опционально, есть дефолты) -----------------------------
# VET_API_MODEL_PATH=data/gguf/qwen3-8b-vet-Q4_K_M.gguf
# VET_API_MODEL_ID=qwen3-8b-vet
# VET_API_N_CTX=4096
# VET_API_N_GPU_LAYERS=0
# VET_API_CHROMA_DIR=data/chroma_db
# VET_API_RAG_TOP_K=3

# --- Аутентификация и мультитенантность (T-039) -----------------------------
# Секрет подписи JWT. Обязательно замените в production: минимум 16 символов.
# VET_API_JWT_SECRET=dev-insecure-jwt-secret-change-me
# Срок жизни access-токена в минутах (по умолчанию 7 дней).
# VET_API_ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Публичная регистрация; в production установите false.
# VET_API_ALLOW_PUBLIC_REGISTRATION=true

# --- PostgreSQL для Docker Compose (T-033) ----------------------------------
# Пароль замените в реальном `.env`; значения по умолчанию подходят для локалки.
POSTGRES_USER=vetassistant
POSTGRES_PASSWORD=vetassistant
POSTGRES_DB=vetassistant
# Для docker compose URL собирается автоматически, при необходимости переопределите:
# VET_API_DATABASE_URL=postgresql+asyncpg://vetassistant:vetassistant@db:5432/vetassistant
# Локальный запуск без Docker использует async SQLite по умолчанию:
# VET_API_DATABASE_URL=sqlite+aiosqlite:///./data/vetassistant.db

# --- Streamlit UI (опционально; в Docker Compose задаётся автоматически) ----
# Для локального запуска UI: http://127.0.0.1:8000/v1/chat/completions
# Для docker compose: http://api:8000/v1/chat/completions
# VET_UI_API_URL=http://127.0.0.1:8000/v1/chat/completions
# VET_UI_MODEL_ID=qwen3-8b-vet
# VET_UI_TIMEOUT_S=300

# --- React-фронтенд (T-037) -------------------------------------------------
# Локально адрес API задаётся в frontend/.env (VITE_API_BASE_URL).
# В Docker Nginx проксирует /api в сервис api.
FRONTEND_PORT=3000
# VITE_FRONTEND_API_BASE_URL=/api

# --- Telegram-бот (T-035) ---------------------------------------------------
# Токен получите у @BotFather: /newbot -> имя -> username -> токен.
# Без токена контейнер bot завершится с понятной ошибкой, API и UI продолжат работу.
TELEGRAM_BOT_TOKEN=
# Для локального запуска: http://127.0.0.1:8000/v1/chat/completions
# Для docker compose: http://api:8000/v1/chat/completions
# VET_BOT_API_URL=http://127.0.0.1:8000/v1/chat/completions
# VET_BOT_MODEL_ID=qwen3-8b-vet
# VET_BOT_TIMEOUT_S=300
# VET_BOT_TEMPERATURE=0.7
# VET_BOT_USE_RAG=true
# VET_BOT_USE_TOOLS=true
# VET_BOT_MAX_HISTORY_MESSAGES=20
# Секрет HMAC для синтетических аккаунтов Telegram-пользователей.
# Если пусто, используется TELEGRAM_BOT_TOKEN (стабильно между перезапусками).
# VET_BOT_AUTH_SECRET=
# Закрытый доступ: Telegram ID, которым разрешён бот (через запятую).
# Пусто — бот не запустится (fail closed).
# VET_BOT_ALLOWED_TELEGRAM_IDS=
# База Telegram Bot API. Если api.telegram.org заблокирован с сервера,
# укажите URL reverse-proxy (Cloudflare Worker).
# VET_BOT_TELEGRAM_API_BASE=https://api.telegram.org
