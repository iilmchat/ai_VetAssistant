# ============================================================================
# VetAssistant — production-шаблон переменных окружения (T-040/T-043).
#
# Скопируйте файл в `.env` на VPS и заполните секреты:
#   cp .env.production.example .env
#   chmod 600 .env
#
# `.env` НИКОГДА не коммитится (см. .gitignore). Реальные пароли и токены
# храните только на сервере и в менеджере секретов.
#
# Генерация надёжных секретов (выполните два раза, результат разный):
#   openssl rand -hex 32
#
# ВАЖНО: для POSTGRES_PASSWORD используйте hex-строку без спецсимволов,
# иначе её нужно percent-кодировать в DATABASE_URL.
# ============================================================================

# --- Обязательные секреты ---------------------------------------------------
POSTGRES_USER=vetassistant
POSTGRES_PASSWORD=
POSTGRES_DB=vetassistant

# Секрет подписи JWT (>= 32 байта энтропии). Сгенерируйте: openssl rand -hex 32
VET_API_JWT_SECRET=

# --- Telegram-бот (T-121) ---------------------------------------------------
# Токен от @BotFather. Без него контейнер bot не запустится.
TELEGRAM_BOT_TOKEN=
# Закрытый доступ: только эти Telegram ID могут пользоваться ботом
# (через запятую). Пусто — bot завершится с ошибкой (fail closed).
# Аккаунт для ID создаёт администратор после одобрения заявки.
VET_BOT_ALLOWED_TELEGRAM_IDS=

# --- Домен и Let's Encrypt --------------------------------------------------
# Домен, на который указывает A-запись (без https:// и завершающего слеша).
VET_DOMAIN=vetassistant.example.com
# Для standalone-деплоя через deploy.sh/Certbot. На общем VPS TLS завершает
# Caddy, и этот email не используется.
LETSENCRYPT_EMAIL=admin@example.com

# --- API --------------------------------------------------------------------
# Переопределять не обязательно: production compose собирает URL из
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB.
# VET_API_DATABASE_URL=postgresql+asyncpg://vetassistant:...@db:5432/vetassistant
VET_API_ALLOW_PUBLIC_REGISTRATION=false
VET_API_ACCESS_TOKEN_EXPIRE_MINUTES=10080
VET_API_MODEL_PATH=/app/data/gguf/qwen3-8b-vet-Q4_K_M.gguf
VET_API_MODEL_ID=qwen3-8b-vet
# Размер контекста модели. 4096 экономит RAM на CPU-инференсе.
# Если сервер начинает тормозить или контейнер api вылетает по OOM,
# снизьте значение до 2048 и перезапустите стек.
VET_API_N_CTX=4096
VET_API_N_GPU_LAYERS=0
VET_API_CHROMA_DIR=/app/data/chroma_db
VET_API_CHROMA_COLLECTION=msd_vet_manual
VET_API_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VET_API_RAG_TOP_K=3
# Автоматически строить ChromaDB при старте API, если индекса ещё нет.
# Ingest выполняется до загрузки LLM, поэтому не конкурирует с ней за RAM.
VET_API_AUTO_INGEST=1
# 1 — падать при ошибке ingest; 0 — запускать API без RAG (по умолчанию).
VET_API_INGEST_STRICT=0
