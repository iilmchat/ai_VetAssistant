# --- Production TLS / ACME (не коммитим ключи и сертификаты) ---
deploy/certbot/conf/
deploy/certbot/www/

# --- Сгенерированные данные: воспроизводимы из seeds, в git не нужны ---
data/*.jsonl
!data/seeds.jsonl
!data/eval_dataset.jsonl
!data/model_answers.jsonl
!data/router_benchmark.jsonl
data/*.csv
data/*.parquet
data/*.db
data/*.sqlite3

