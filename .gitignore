# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.installed.cfg

# --- Виртуальные окружения ---
.venv/
venv/
env/

# --- Секреты (RULES §4) ---
.env
.env.*
!.env.example
